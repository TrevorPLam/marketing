{
  "name": "@marketing/ui",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./button": {
      "types": "./src/components/button/index.ts",
      "import": "./src/components/button/index.ts",
      "require": "./src/components/button/index.ts"
    },
    "./input": {
      "types": "./src/components/input/index.ts",
      "import": "./src/components/input/index.ts",
      "require": "./src/components/input/index.ts"
    },
    "./navigation": {
      "types": "./src/components/navigation/index.ts",
      "import": "./src/components/navigation/index.ts",
      "require": "./src/components/navigation/index.ts"
    },
    "./footer": {
      "types": "./src/components/footer/index.ts",
      "import": "./src/components/footer/index.ts",
      "require": "./src/components/footer/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "build:css": "npx tailwindcss -i src/styles/globals.css -o dist/styles/globals.css --minify",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "eslint-plugin-storybook": "^10.4.2",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "prettier": "^3.2.0",
    "storybook": "^10.4.2",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.1",
    "typescript": "^5.3.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
